# Clean Node image for the install matrix. Nothing from the repo is baked in:
# the package is installed at `docker run` time from the harness registry (or
# the packed tarball mounted at /pkg), so every run starts from a fresh $HOME.
#
#   BASE          node:22-bookworm-slim | node:20-bookworm-slim | node:24-bookworm-slim | node:22-bookworm ...
#   PYTHON        none  -> leave the base image as is (slim images have no python3)
#                 venv  -> apt install python3 python3-venv (curl_cffi venv expected)
#   BROWSER_DEPS  1     -> apt install the shared libs Chromium headless-shell needs
#                          (only for the live search_products variant)
ARG BASE=node:22-bookworm-slim
FROM ${BASE}
ARG PYTHON=none
ARG BROWSER_DEPS=0
RUN set -eux; \
    pkgs="ca-certificates"; \
    if [ "$PYTHON" = "venv" ]; then pkgs="$pkgs python3 python3-venv"; fi; \
    if [ "$BROWSER_DEPS" = "1" ]; then pkgs="$pkgs libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libdbus-1-3 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 libpango-1.0-0 libcairo2 libatspi2.0-0 libx11-6 libxcb1 libxext6 fonts-liberation"; fi; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $pkgs; \
    rm -rf /var/lib/apt/lists/*
USER node
WORKDIR /home/node
ENV ALZA_TOKEN_FILE=none
