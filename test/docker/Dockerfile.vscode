# VS Code (official Microsoft .deb) + Xvfb, for driving the README "Install in
# VS Code" link against a brand-new profile. Node is only used by the CDP driver
# (playwright-core, installed at build time into /opt/driver); nothing from the
# repo is baked in. Runs as the unprivileged `node` user.
FROM node:22-bookworm-slim
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl xvfb xauth x11-utils imagemagick dbus-x11 \
      libasound2 libgbm1 libgtk-3-0 libnss3 libxkbfile1 libsecret-1-0 libxss1 libatk-bridge2.0-0 \
      fonts-dejavu-core; \
    curl -fsSL -o /tmp/code.deb 'https://update.code.visualstudio.com/latest/linux-deb-x64/stable'; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends /tmp/code.deb; \
    rm -rf /tmp/code.deb /var/lib/apt/lists/*; \
    mkdir -p /opt/driver && cd /opt/driver && npm init -y >/dev/null && npm install --no-audit --no-fund playwright-core@1 >/dev/null; \
    dpkg-query -W code
USER node
WORKDIR /home/node
